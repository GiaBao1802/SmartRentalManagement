PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://goctro:replace-with-local-postgres-password@localhost:5432/Goctro_test3?schema=public
NODE_ENV=development
# For production, generate a unique random value of at least 32 bytes.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_MINUTES=15
# Local/dev only: generate a random 32-byte AES key and keep it in ignored backend/.env.
# Production must source key versions from the deployment secret manager/KMS.
CONTRACT_IDEMPOTENCY_ACTIVE_KEY_VERSION=
CONTRACT_IDEMPOTENCY_KEYS_JSON=
