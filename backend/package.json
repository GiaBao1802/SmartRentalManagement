{
  "name": "@goctro/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:auth": "tsx --test src/auth/auth.test.ts",
    "test:accounts": "tsx --test src/accounts/account.test.ts src/accounts/account.repository.test.ts",
    "test:accounts:runtime": "tsx --test src/accounts/account.postgres.integration.test.ts",
    "test:legacy-retirement": "tsx --test src/legacy-retirement.test.ts",
    "dev:provision-admin": "tsx scripts/provision-dev-admin.ts",
    "test:property-room": "tsx --test src/properties/property-room.test.ts",
    "test:resident-occupancy": "tsx --test src/residents/resident.test.ts",
    "test:room-images": "tsx --test src/room-images/room-image.test.ts src/room-images/room-image.repository.test.ts src/room-images/room-image.routes.test.ts",
    "test:public-marketplace": "tsx --test src/public-marketplace/public-marketplace.routes.test.ts",
    "test:contracts": "tsx --test src/contracts/contract.validation.test.ts src/contracts/contract.repository.test.ts src/contracts/contract.routes.test.ts src/contracts/contract-idempotency.test.ts src/contract-documents/contract-document.service.test.ts",
    "test:contracts:runtime": "tsx --test src/contracts/contract-idempotency.integration.test.ts",
    "test:invoices": "tsx --test src/invoices/invoice.billing.test.ts src/invoices/billing-workspace.repository.test.ts src/invoices/billing-workspace.postgres.integration.test.ts src/invoices/billing-scheduler.test.ts src/invoices/invoice.validation.test.ts src/invoices/invoice.repository.test.ts src/invoices/invoice.routes.test.ts src/invoices/utility-tariff.resolver.test.ts src/invoices/utility-tariff.repository.test.ts src/invoices/meter-continuity.resolver.test.ts src/invoices/meter-continuity.repository.test.ts src/invoices/fixed-service-price.resolver.test.ts src/invoices/fixed-service-price.repository.test.ts src/invoices/flexible-service-charge.resolver.test.ts src/invoices/flexible-service-charge.repository.test.ts src/invoices/parking-billing.resolver.test.ts src/invoices/parking-billing.repository.test.ts src/invoices/invoice-itemized.calculator.test.ts src/invoices/invoice-itemized.postgres.integration.test.ts src/invoices/billing-scheduler.postgres.integration.test.ts src/zalo/invoice-zalo.service.test.ts",
    "test:service-utilities": "tsx --test src/services/utility-tariff.routes.test.ts src/services/utility-tariff-management.repository.test.ts src/services/property-service.routes.test.ts src/services/property-service.postgres.integration.test.ts",
    "db:generate": "prisma generate --schema ../database/schema.prisma",
    "db:validate": "prisma validate --schema ../database/schema.prisma",
    "db:bootstrap": "node ../scripts/database-v18.mjs bootstrap",
    "db:migrate": "node ../scripts/database-v18.mjs block-legacy-migrate",
    "db:seed": "node ../scripts/database-v18.mjs seed",
    "test:enrollment": "tsx --test src/accounts/enrollment.test.ts",
    "test:enrollment:runtime": "tsx --test src/accounts/enrollment.postgres.integration.test.ts"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "prisma": "6.12.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
