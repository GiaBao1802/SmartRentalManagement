model FlexibleServiceCharge {
  flexibleServiceChargeId BigInt   @id @default(autoincrement()) @map("flexible_service_charge_id")
  ownerId                 BigInt   @map("owner_id")
  propertyId              BigInt   @map("property_id")
  roomId                  BigInt   @map("room_id")
  contractId              BigInt   @map("contract_id")
  residentId              BigInt?  @map("resident_id")
  propertyPricingItemId   BigInt   @map("property_pricing_item_id")
  kind                    String   @default("FLEXIBLE_SERVICE") @db.VarChar(24)
  propertyPriceVersionId  BigInt   @map("property_price_version_id")
  occurredAt              DateTime @map("occurred_at") @db.Timestamptz(6)
  quantity                Decimal  @db.Decimal(12, 3)
  unit                    String   @db.VarChar(30)
  unitPriceSnapshot       BigInt   @map("unit_price_snapshot")
  amount                  BigInt
  sourceSystem            String   @map("source_system") @db.VarChar(80)
  sourceEventKey          String   @map("source_event_key") @db.VarChar(200)
  payloadFingerprint      Bytes    @map("payload_fingerprint")
  status                  String   @default("READY") @db.VarChar(16)
  invoiceId               BigInt?  @map("invoice_id")
  actorAccountId          BigInt   @map("actor_account_id")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  pricingItem  PropertyPricingItem  @relation(fields: [propertyPricingItemId, ownerId, propertyId, kind], references: [propertyPricingItemId, ownerId, propertyId, kind], onDelete: Restrict)
  priceVersion PropertyPriceVersion @relation(fields: [propertyPriceVersionId, ownerId, propertyId, kind], references: [propertyPriceVersionId, ownerId, propertyId, kind], onDelete: Restrict)
  room         Room                 @relation(fields: [roomId, propertyId, ownerId], references: [roomId, propertyId, ownerId], onDelete: Restrict)
  contract     Contract             @relation(fields: [contractId, roomId, propertyId, ownerId], references: [contractId, roomId, propertyId, ownerId], onDelete: Restrict)
  resident     Resident?            @relation(fields: [residentId, ownerId], references: [residentId, ownerId], onDelete: Restrict)
  actor        Account              @relation(fields: [actorAccountId, ownerId], references: [accountId, ownerId], onDelete: Restrict)
  invoice      Invoice?             @relation(fields: [invoiceId, contractId, propertyId, ownerId], references: [invoiceId, contractId, propertyId, ownerId], onDelete: Restrict)
  invoiceItems InvoiceItem[]

  @@unique([ownerId, sourceSystem, sourceEventKey])
  @@unique([flexibleServiceChargeId, ownerId, propertyId])
  @@map("flexible_service_charges")
}

model ParkingEntitlement {
  parkingEntitlementId  BigInt   @id @default(autoincrement()) @map("parking_entitlement_id")
  ownerId               BigInt   @map("owner_id")
  propertyId            BigInt   @map("property_id")
  entitlementType       String   @map("entitlement_type") @db.VarChar(32)
  billability           String   @db.VarChar(16)
  propertyPricingItemId BigInt?  @map("property_pricing_item_id")
  pricingKind           String?  @map("pricing_kind") @db.VarChar(24)
  code                  String   @db.VarChar(60)
  name                  String   @db.VarChar(150)
  active                Boolean  @default(true)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  property     Property                @relation(fields: [propertyId, ownerId], references: [propertyId, ownerId], onDelete: Restrict)
  pricingItem  PropertyPricingItem?    @relation(fields: [propertyPricingItemId, ownerId, propertyId, pricingKind], references: [propertyPricingItemId, ownerId, propertyId, kind], onDelete: Restrict)
  assignments  ParkingSlotAssignment[]
  invoiceItems InvoiceItem[]

  @@unique([propertyId, code])
  @@unique([parkingEntitlementId, ownerId, propertyId])
  @@map("parking_entitlements")
}

model MeterReading {
  meterReadingId      BigInt   @id @default(autoincrement()) @map("meter_reading_id")
  ownerId             BigInt   @map("owner_id")
  propertyId          BigInt   @map("property_id")
  roomId              BigInt   @map("room_id")
  contractId          BigInt   @map("contract_id")
  utilityType         String   @map("utility_type") @db.VarChar(16)
  value               Decimal  @db.Decimal(12, 3)
  readingAt           DateTime @map("reading_at") @db.Timestamptz(6)
  source              String   @default("MANUAL") @db.VarChar(16)
  actorAccountId      BigInt   @map("actor_account_id")
  note                String?  @db.Text
  supersedesReadingId BigInt?  @map("supersedes_reading_id")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  room             Room                          @relation(fields: [roomId, propertyId, ownerId], references: [roomId, propertyId, ownerId], onDelete: Restrict)
  contract         Contract                      @relation(fields: [contractId, roomId, propertyId, ownerId], references: [contractId, roomId, propertyId, ownerId], onDelete: Restrict)
  actor            Account                       @relation(fields: [actorAccountId, ownerId], references: [accountId, ownerId], onDelete: Restrict)
  supersedes       MeterReading?                 @relation("MeterReadingSupersession", fields: [supersedesReadingId, ownerId, propertyId, roomId, contractId, utilityType], references: [meterReadingId, ownerId, propertyId, roomId, contractId, utilityType], onDelete: Restrict)
  supersededBy     MeterReading[]                @relation("MeterReadingSupersession")
  invoiceSnapshots InvoiceMeterReadingSnapshot[]

  @@unique([meterReadingId, ownerId, propertyId, roomId, contractId, utilityType])
  @@index([ownerId, contractId, utilityType, readingAt(sort: Desc)])
  @@map("meter_readings")
}

model InvoiceMeterReadingSnapshot {
  invoiceMeterReadingSnapshotId BigInt        @id @default(autoincrement()) @map("invoice_meter_reading_snapshot_id")
  invoiceId                     BigInt        @map("invoice_id")
  ownerId                       BigInt        @map("owner_id")
  propertyId                    BigInt        @map("property_id")
  roomId                        BigInt        @map("room_id")
  contractId                    BigInt        @map("contract_id")
  utilityType                   String        @map("utility_type") @db.VarChar(16)
  snapshotRole                  String        @map("snapshot_role") @db.VarChar(8)
  value                         Decimal       @db.Decimal(12, 3)
  readingAt                     DateTime?     @map("reading_at") @db.Timestamptz(6)
  sourceKind                    String        @map("source_kind") @db.VarChar(32)
  sourceMeterReadingId          BigInt?       @map("source_meter_reading_id")
  sourceInvoiceId               BigInt?       @map("source_invoice_id")
  sourceContractId              BigInt?       @map("source_contract_id")
  createdAt                     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  invoiceContext                Invoice       @relation("InvoiceSnapshotContext", fields: [invoiceId, contractId, propertyId, ownerId], references: [invoiceId, contractId, propertyId, ownerId], onDelete: Restrict)
  room                          Room          @relation(fields: [roomId, propertyId, ownerId], references: [roomId, propertyId, ownerId], onDelete: Restrict)
  sourceReading                 MeterReading? @relation(fields: [sourceMeterReadingId, ownerId, propertyId, roomId, contractId, utilityType], references: [meterReadingId, ownerId, propertyId, roomId, contractId, utilityType], onDelete: Restrict)
  sourceInvoice                 Invoice?      @relation("InvoiceSnapshotSourceInvoice", fields: [sourceInvoiceId, contractId, propertyId, ownerId], references: [invoiceId, contractId, propertyId, ownerId], onDelete: Restrict)
  sourceContract                Contract?     @relation("InvoiceSnapshotSourceContract", fields: [sourceContractId, roomId, propertyId, ownerId], references: [contractId, roomId, propertyId, ownerId], onDelete: Restrict)

  @@unique([invoiceId, utilityType, snapshotRole])
  @@map("invoice_meter_reading_snapshots")
}

model InvoiceItem {
  invoiceItemId           BigInt                       @id @default(autoincrement()) @map("invoice_item_id")
  invoiceId               BigInt                       @map("invoice_id")
  ownerId                 BigInt                       @map("owner_id")
  propertyId              BigInt                       @map("property_id")
  contractId              BigInt                       @map("contract_id")
  itemKey                 String                       @map("item_key") @db.VarChar(100)
  category                String                       @db.VarChar(24)
  sourceType              String                       @map("source_type") @db.VarChar(32)
  sourceReference         String?                      @map("source_reference") @db.Text
  utilityTariffVersionId  BigInt?                      @map("utility_tariff_version_id")
  utilityType             String?                      @map("utility_type") @db.VarChar(16)
  propertyPriceVersionId  BigInt?                      @map("property_price_version_id")
  pricingKind             String?                      @map("pricing_kind") @db.VarChar(24)
  flexibleServiceChargeId BigInt?                      @map("flexible_service_charge_id")
  parkingAssignmentId     BigInt?                      @map("parking_assignment_id")
  parkingEntitlementId    BigInt?                      @map("parking_entitlement_id")
  labelSnapshot           String                       @map("label_snapshot") @db.VarChar(200)
  descriptionSnapshot     String?                      @map("description_snapshot") @db.Text
  quantity                Decimal                      @db.Decimal(12, 3)
  unit                    String                       @db.VarChar(30)
  unitPriceSnapshot       BigInt?                      @map("unit_price_snapshot")
  amount                  BigInt
  calculationRuleVersion  String                       @map("calculation_rule_version") @db.VarChar(40)
  applicablePeriodStart   DateTime?                    @map("applicable_period_start") @db.Date
  applicablePeriodEnd     DateTime?                    @map("applicable_period_end") @db.Date
  createdAt               DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  invoice                 Invoice                      @relation(fields: [invoiceId, contractId, propertyId, ownerId], references: [invoiceId, contractId, propertyId, ownerId], onDelete: Restrict)
  tariffVersion           UtilityTariffVersion?        @relation(fields: [utilityTariffVersionId, ownerId, propertyId, utilityType], references: [utilityTariffVersionId, ownerId, propertyId, utilityType], onDelete: Restrict)
  priceVersion            PropertyPriceVersion?        @relation(fields: [propertyPriceVersionId, ownerId, propertyId, pricingKind], references: [propertyPriceVersionId, ownerId, propertyId, kind], onDelete: Restrict)
  flexibleServiceCharge   FlexibleServiceCharge?       @relation(fields: [flexibleServiceChargeId, ownerId, propertyId], references: [flexibleServiceChargeId, ownerId, propertyId], onDelete: Restrict)
  parkingAssignment       ParkingSlotAssignment?       @relation(fields: [parkingAssignmentId, ownerId, propertyId], references: [assignmentId, ownerId, propertyId], onDelete: Restrict)
  parkingEntitlement      ParkingEntitlement?          @relation(fields: [parkingEntitlementId, ownerId, propertyId], references: [parkingEntitlementId, ownerId, propertyId], onDelete: Restrict)
  electricityTiers        InvoiceItemElectricityTier[]

  @@unique([invoiceId, itemKey])
  @@unique([invoiceItemId, utilityTariffVersionId])
  @@unique([flexibleServiceChargeId])
  // V1.8 SQL-authoritative partial unique index:
  // (invoice_id, parking_assignment_id) WHERE parking_assignment_id IS NOT NULL.
  // Prisma 6.12 cannot represent this partial-index predicate; do not model as full @@unique.
  @@map("invoice_items")
}

model InvoiceItemElectricityTier {
  invoiceItemElectricityTierId BigInt   @id @default(autoincrement()) @map("invoice_item_electricity_tier_id")
  invoiceItemId                BigInt   @map("invoice_item_id")
  utilityTariffVersionId       BigInt   @map("utility_tariff_version_id")
  electricityTariffTierId      BigInt?  @map("electricity_tariff_tier_id")
  tierNo                       Int      @map("tier_no")
  lowerKwh                     Decimal  @map("lower_kwh") @db.Decimal(12, 3)
  upperKwh                     Decimal? @map("upper_kwh") @db.Decimal(12, 3)
  quantity                     Decimal  @db.Decimal(12, 3)
  unitPriceSnapshot            BigInt   @map("unit_price_snapshot")
  amount                       BigInt
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  invoiceItem     InvoiceItem            @relation(fields: [invoiceItemId, utilityTariffVersionId], references: [invoiceItemId, utilityTariffVersionId], onDelete: Restrict)
  electricityTier ElectricityTariffTier? @relation(fields: [electricityTariffTierId, utilityTariffVersionId], references: [electricityTariffTierId, utilityTariffVersionId], onDelete: Restrict)

  @@unique([invoiceItemId, tierNo])
  @@unique([invoiceItemId, utilityTariffVersionId])
  @@map("invoice_item_electricity_tiers")
}
