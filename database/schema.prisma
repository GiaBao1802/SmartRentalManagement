generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Database V1.10 application mapping; SQL baseline: database/baselines/v1.10/schema.sql.
// auth_sessions is accessed by backend SQL and intentionally has no Prisma model.
// V1.8 recurring Parking partial uniqueness is enforced by SQL, not a Prisma @@unique.
// Status domains remain varchar + PostgreSQL CHECK constraints.
// Keep these as String so Prisma does not expect native PostgreSQL enum types.

model Owner {
  ownerId      BigInt   @id @default(autoincrement()) @map("owner_id")
  displayName  String   @map("display_name") @db.VarChar(200)
  contactPhone String?  @map("contact_phone") @db.VarChar(30)
  contactEmail String?  @map("contact_email") @db.VarChar(254)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  accounts                    Account[]
  properties                  Property[]
  residents                   Resident[]
  accountInvitations          AccountInvitation[]
  contractChangeHistory       ContractChangeHistory[]
  contractIdempotencyRequests ContractIdempotencyRequest[]

  @@map("owners")
}

model Property {
  propertyId   BigInt   @id @default(autoincrement()) @map("property_id")
  ownerId      BigInt   @map("owner_id")
  propertyCode String   @map("property_code") @db.VarChar(40)
  name         String   @db.VarChar(150)
  province     String   @db.VarChar(120)
  address      String   @db.Text
  managerName  String?  @map("manager_name") @db.VarChar(150)
  status       String   @default("active") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  owner                Owner                 @relation(fields: [ownerId], references: [ownerId], onDelete: Restrict)
  rooms                Room[]
  amenities            Amenity[]
  parkingAreas         ParkingArea[]
  complaints           Complaint[]
  contactRequests      ContactRequest[]
  utilityTariffs       UtilityTariff[]
  propertyFacilities   PropertyFacility[]
  propertyPricingItems PropertyPricingItem[]
  parkingEntitlements  ParkingEntitlement[]

  @@unique([ownerId, propertyCode], map: "properties_owner_id_property_code_key")
  @@unique([propertyId, ownerId], map: "properties_property_id_owner_id_key")
  @@index([ownerId, status], map: "properties_by_owner_status")
  @@map("properties")
}

model Room {
  roomId            BigInt   @id @default(autoincrement()) @map("room_id")
  propertyId        BigInt   @map("property_id")
  ownerId           BigInt   @map("owner_id")
  roomCode          String   @map("room_code") @db.VarChar(40)
  status            String   @default("available") @db.VarChar(20)
  areaM2            Decimal  @map("area_m2") @db.Decimal(8, 2)
  defaultRent       BigInt   @map("default_rent")
  defaultCapacity   Int      @map("default_capacity")
  isActive          Boolean  @default(true) @map("is_active")
  isPublic          Boolean  @default(false) @map("is_public")
  publicDescription String?  @map("public_description") @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  property                     Property                      @relation(fields: [propertyId, ownerId], references: [propertyId, ownerId], onDelete: Restrict)
  contracts                    Contract[]
  roomResidents                RoomResident[]
  parkingAssignments           ParkingSlotAssignment[]
  complaints                   Complaint[]
  contactRequests              ContactRequest[]
  images                       RoomImage[]
  flexibleServiceCharges       FlexibleServiceCharge[]
  meterReadings                MeterReading[]
  invoiceMeterReadingSnapshots InvoiceMeterReadingSnapshot[]

  @@unique([propertyId, roomCode], map: "rooms_property_id_room_code_key")
  @@unique([roomId, propertyId], map: "rooms_room_id_property_id_key")
  @@unique([roomId, propertyId, ownerId], map: "rooms_room_id_property_id_owner_id_key")
  @@unique([roomId, ownerId], map: "rooms_room_id_owner_id_key")
  @@index([propertyId, status, roomCode], map: "rooms_by_property_status")
  @@map("rooms")
}

model Resident {
  residentId                  BigInt    @id @default(autoincrement()) @map("resident_id")
  ownerId                     BigInt    @map("owner_id")
  nationalId                  String?   @map("national_id") @db.VarChar(12)
  fullName                    String    @map("full_name") @db.VarChar(200)
  avatarStorageKey            String?   @map("avatar_storage_key") @db.Text
  phone                       String?   @db.VarChar(30)
  email                       String?   @db.VarChar(254)
  birthDate                   DateTime? @map("birth_date") @db.Date
  gender                      String?   @db.VarChar(40)
  residenceStatus             String    @default("living") @map("residence_status") @db.VarChar(20)
  residenceRegistrationStatus String    @default("not_completed") @map("residence_registration_status") @db.VarChar(32)
  archivedAt                  DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  owner                   Owner                   @relation(fields: [ownerId], references: [ownerId], onDelete: Restrict)
  account                 Account?
  accountInvitations      AccountInvitation[]
  representativeContracts Contract[]
  roomResidents           RoomResident[]
  invoiceZaloOaSendLogs   InvoiceZaloOaSendLog[]
  amenitySubscriptions    AmenitySubscription[]
  vehicles                Vehicle[]
  parkingAssignments      ParkingSlotAssignment[]
  complaints              Complaint[]
  flexibleServiceCharges  FlexibleServiceCharge[]

  @@unique([ownerId, nationalId], map: "residents_owner_id_national_id_key")
  @@unique([residentId, ownerId], map: "residents_resident_id_owner_id_key")
  @@map("residents")
}

model Account {
  accountId    BigInt    @id @default(autoincrement()) @map("account_id")
  ownerId      BigInt?   @unique(map: "accounts_owner_id_key") @map("owner_id")
  residentId   BigInt?   @unique(map: "accounts_resident_id_key") @map("resident_id")
  role         String    @db.VarChar(16)
  email        String?   @unique(map: "accounts_email_key") @db.VarChar(254)
  phone        String?   @unique(map: "accounts_phone_nonnull_key") @db.VarChar(30)
  passwordHash String    @map("password_hash") @db.Text
  status       String    @default("active") @db.VarChar(16)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  owner                          Owner?                       @relation(fields: [ownerId], references: [ownerId], onDelete: Restrict)
  resident                       Resident?                    @relation(fields: [residentId], references: [residentId], onDelete: Restrict)
  accountInvitations             AccountInvitation[]          @relation("InvitationCreator")
  uploadedContractDocs           ContractDocument[]           @relation("ContractDocumentUploader")
  complaintHistoryEvents         ComplaintHistory[]
  contractChangeHistoryEvents    ContractChangeHistory[]      @relation("ContractChangeHistoryActor")
  contractIdempotencyRequests    ContractIdempotencyRequest[]
  notifications                  Notification[]
  notificationPreference         NotificationPreference?
  publishedUtilityTariffVersions UtilityTariffVersion[]       @relation("UtilityTariffVersionPublisher")
  createdUtilityTariffVersions   UtilityTariffVersion[]       @relation("UtilityTariffVersionCreator")
  publishedPropertyPriceVersions PropertyPriceVersion[]       @relation("PropertyPriceVersionPublisher")
  createdPropertyPriceVersions   PropertyPriceVersion[]       @relation("PropertyPriceVersionCreator")
  flexibleServiceCharges         FlexibleServiceCharge[]
  meterReadings                  MeterReading[]

  @@unique([accountId, ownerId], map: "accounts_id_owner_unique")
  @@index([status, role], map: "accounts_by_status_role")
  @@map("accounts")
}

model ContractIdempotencyRequest {
  requestId          BigInt    @id @default(autoincrement()) @map("request_id")
  ownerId            BigInt    @map("owner_id")
  accountId          BigInt    @map("account_id")
  operationScope     String    @map("operation_scope") @db.VarChar(200)
  idempotencyKeyHash Bytes     @map("idempotency_key_hash") @db.ByteA
  requestFingerprint Bytes     @map("request_fingerprint") @db.ByteA
  fingerprintVersion Int       @default(1) @map("fingerprint_version") @db.SmallInt
  state              String    @default("in_progress") @db.VarChar(16)
  responseStatus     Int?      @map("response_status") @db.SmallInt
  responseCiphertext Bytes?    @map("response_ciphertext") @db.ByteA
  responseNonce      Bytes?    @map("response_nonce") @db.ByteA
  responseAuthTag    Bytes?    @map("response_auth_tag") @db.ByteA
  responseKeyVersion String?   @map("response_key_version") @db.VarChar(64)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)

  owner   Owner   @relation(fields: [ownerId], references: [ownerId], onDelete: Restrict)
  account Account @relation(fields: [accountId, ownerId], references: [accountId, ownerId], onDelete: Restrict)

  @@unique([ownerId, accountId, operationScope, idempotencyKeyHash], map: "contract_idempotency_requests_scope_key_key")
  @@index([accountId, ownerId], map: "contract_idempotency_requests_account_owner_idx")
  @@map("contract_idempotency_requests")
}

model AccountInvitation {
  invitationId       BigInt    @id @default(autoincrement()) @map("invitation_id")
  ownerId            BigInt    @map("owner_id")
  residentId         BigInt    @map("resident_id")
  createdByAccountId BigInt    @map("created_by_account_id")
  tokenHash          String    @unique(map: "account_invitations_token_hash_key") @map("token_hash") @db.VarChar(64)
  status             String    @default("pending") @db.VarChar(16)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt         DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  owner     Owner    @relation(fields: [ownerId], references: [ownerId], onDelete: Restrict)
  resident  Resident @relation(fields: [residentId, ownerId], references: [residentId, ownerId], onDelete: Restrict)
  createdBy Account  @relation("InvitationCreator", fields: [createdByAccountId, ownerId], references: [accountId, ownerId], onDelete: Restrict)

  @@index([ownerId, residentId, status, createdAt(sort: Desc)], map: "account_invitations_by_resident_status")
  @@map("account_invitations")
}

model Contract {
  contractId               BigInt    @id @default(autoincrement()) @map("contract_id")
  contractNo               String    @unique(map: "contracts_contract_no_key") @map("contract_no") @db.VarChar(40)
  roomId                   BigInt    @map("room_id")
  propertyId               BigInt    @map("property_id")
  ownerId                  BigInt    @map("owner_id")
  representativeResidentId BigInt    @map("representative_resident_id")
  previousContractId       BigInt?   @map("previous_contract_id")
  startDate                DateTime  @map("start_date") @db.Date
  endDate                  DateTime  @map("end_date") @db.Date
  status                   String    @default("draft") @db.VarChar(16)
  revision                 Int       @default(0) @map("revision")
  rentAmount               BigInt    @map("rent_amount")
  depositAmount            BigInt    @map("deposit_amount")
  residentCapacity         Int       @map("resident_capacity")
  initialElectricKwh       Decimal?  @map("initial_electric_kwh") @db.Decimal(12, 3)
  initialWaterM3           Decimal?  @map("initial_water_m3") @db.Decimal(12, 3)
  terminationDate          DateTime? @map("termination_date") @db.Date
  terminationReason        String?   @map("termination_reason") @db.Text
  finalElectricKwh         Decimal?  @map("final_electric_kwh") @db.Decimal(12, 3)
  finalWaterM3             Decimal?  @map("final_water_m3") @db.Decimal(12, 3)
  depositDeduction         BigInt?   @map("deposit_deduction")
  depositSettlementAmount  BigInt?   @map("deposit_settlement_amount")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  room                         Room                          @relation(fields: [roomId, propertyId, ownerId], references: [roomId, propertyId, ownerId], onDelete: Restrict)
  representativeResident       Resident                      @relation(fields: [representativeResidentId, ownerId], references: [residentId, ownerId], onDelete: Restrict)
  previousContract             Contract?                     @relation("ContractRenewal", fields: [previousContractId, roomId, ownerId], references: [contractId, roomId, ownerId], onDelete: Restrict)
  successorContracts           Contract[]                    @relation("ContractRenewal")
  documents                    ContractDocument[]
  roomResidents                RoomResident[]
  invoices                     Invoice[]
  amenitySubscriptions         AmenitySubscription[]
  parkingAssignments           ParkingSlotAssignment[]
  changeHistory                ContractChangeHistory[]
  flexibleServiceCharges       FlexibleServiceCharge[]
  meterReadings                MeterReading[]
  invoiceMeterReadingSnapshots InvoiceMeterReadingSnapshot[] @relation("InvoiceSnapshotSourceContract")

  @@unique([contractId, ownerId], map: "contracts_id_owner_unique")
  @@unique([contractId, roomId], map: "contracts_contract_id_room_id_key")
  @@unique([contractId, propertyId, ownerId], map: "contracts_contract_id_property_id_owner_id_key")
  @@unique([contractId, roomId, propertyId, ownerId], map: "contracts_contract_id_room_id_property_id_owner_id_key")
  @@unique([contractId, roomId, ownerId], map: "contracts_contract_id_room_id_owner_id_key")
  @@index([ownerId, representativeResidentId, startDate(sort: Desc)], map: "contracts_by_resident")
  @@index([ownerId, roomId, startDate, endDate], map: "contracts_by_room_dates")
  @@map("contracts")
}

model ContractChangeHistory {
  changeId           BigInt   @id @default(autoincrement()) @map("change_id")
  contractId         BigInt   @map("contract_id")
  ownerId            BigInt   @map("owner_id")
  changedByAccountId BigInt   @map("changed_by_account_id")
  revision           Int      @map("revision")
  changeType         String   @map("change_type") @db.VarChar(32)
  changeReason       String?  @map("change_reason") @db.VarChar(1000)
  beforeData         Json     @map("before_data") @db.JsonB
  afterData          Json     @map("after_data") @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  contract         Contract @relation(fields: [contractId, ownerId], references: [contractId, ownerId], onDelete: Restrict)
  owner            Owner    @relation(fields: [ownerId], references: [ownerId], onDelete: Restrict)
  changedByAccount Account  @relation("ContractChangeHistoryActor", fields: [changedByAccountId, ownerId], references: [accountId, ownerId], onDelete: Restrict)

  @@unique([contractId, revision], map: "contract_change_history_contract_id_revision_key")
  @@index([ownerId, contractId, revision(sort: Desc)], map: "contract_change_history_by_owner_contract_revision")
  @@map("contract_change_history")
}

model ContractDocument {
  documentId          BigInt    @id @default(autoincrement()) @map("document_id")
  contractId          BigInt    @map("contract_id")
  propertyId          BigInt    @map("property_id")
  ownerId             BigInt    @map("owner_id")
  fileName            String    @map("file_name") @db.VarChar(255)
  storageKey          String    @unique(map: "contract_documents_storage_key_key") @map("storage_key") @db.Text
  mimeType            String    @map("mime_type") @db.VarChar(150)
  fileSize            BigInt    @map("file_size")
  documentType        String    @map("document_type") @db.VarChar(20)
  version             Int
  checksumSha256      String?   @map("checksum_sha256") @db.VarChar(64)
  status              String    @default("draft") @db.VarChar(16)
  uploadedByAccountId BigInt    @map("uploaded_by_account_id")
  signedAt            DateTime? @map("signed_at") @db.Timestamptz(6)
  signatureProvider   String?   @map("signature_provider") @db.VarChar(100)
  signatureReference  String?   @map("signature_reference") @db.VarChar(255)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  contract   Contract @relation(fields: [contractId, propertyId, ownerId], references: [contractId, propertyId, ownerId], onDelete: Restrict)
  uploadedBy Account  @relation("ContractDocumentUploader", fields: [uploadedByAccountId, ownerId], references: [accountId, ownerId], onDelete: Restrict)

  @@unique([contractId, documentType, version], map: "contract_documents_contract_id_document_type_version_key")
  @@index([ownerId, contractId, documentType, version(sort: Desc)], map: "contract_documents_by_contract")
  @@map("contract_documents")
}

model RoomResident {
  occupancyId BigInt    @id @default(autoincrement()) @map("occupancy_id")
  roomId      BigInt    @map("room_id")
  propertyId  BigInt    @map("property_id")
  ownerId     BigInt    @map("owner_id")
  residentId  BigInt    @map("resident_id")
  contractId  BigInt?   @map("contract_id")
  startedAt   DateTime  @map("started_at") @db.Date
  endedAt     DateTime? @map("ended_at") @db.Date
  status      String    @default("active") @db.VarChar(16)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  room     Room      @relation(fields: [roomId, propertyId, ownerId], references: [roomId, propertyId, ownerId], onDelete: Restrict)
  resident Resident  @relation(fields: [residentId, ownerId], references: [residentId, ownerId], onDelete: Restrict)
  contract Contract? @relation(fields: [contractId, roomId, propertyId, ownerId], references: [contractId, roomId, propertyId, ownerId], onDelete: Restrict)

  @@unique([residentId, roomId, startedAt], map: "room_residents_resident_id_room_id_started_at_key")
  @@index([roomId, ownerId, status, startedAt], map: "room_residents_by_room_status")
  @@index([residentId, ownerId, startedAt(sort: Desc)], map: "room_residents_by_resident")
  @@map("room_residents")
}

model Invoice {
  invoiceId              BigInt    @id @default(autoincrement()) @map("invoice_id")
  invoiceNo              String    @unique(map: "invoices_invoice_no_key") @map("invoice_no") @db.VarChar(40)
  contractId             BigInt    @map("contract_id")
  propertyId             BigInt    @map("property_id")
  ownerId                BigInt    @map("owner_id")
  periodStart            DateTime  @map("period_start") @db.Date
  periodEnd              DateTime  @map("period_end") @db.Date
  dueDate                DateTime? @map("due_date") @db.Date
  rentAmount             BigInt    @default(0) @map("rent_amount")
  electricityPreviousKwh Decimal?  @map("electricity_previous_kwh") @db.Decimal(12, 3)
  electricityCurrentKwh  Decimal?  @map("electricity_current_kwh") @db.Decimal(12, 3)
  electricityAmount      BigInt    @default(0) @map("electricity_amount")
  waterPreviousM3        Decimal?  @map("water_previous_m3") @db.Decimal(12, 3)
  waterCurrentM3         Decimal?  @map("water_current_m3") @db.Decimal(12, 3)
  waterAmount            BigInt    @default(0) @map("water_amount")
  serviceAmount          BigInt    @default(0) @map("service_amount")
  totalAmount            BigInt    @map("total_amount")
  status                 String    @default("draft") @db.VarChar(16)
  snapshotKind           String    @default("NOT_FINALIZED") @map("snapshot_kind") @db.VarChar(24)
  finalizedAt            DateTime? @map("finalized_at") @db.Timestamptz(6)
  revision               Int       @default(1)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  contract                             Contract                      @relation(fields: [contractId, propertyId, ownerId], references: [contractId, propertyId, ownerId], onDelete: Restrict)
  paymentTransactions                  PaymentTransaction[]
  invoiceZaloOaSendLogs                InvoiceZaloOaSendLog[]
  amenityCycles                        AmenitySubscriptionCycle[]
  invoiceItems                         InvoiceItem[]
  meterReadingSnapshots                InvoiceMeterReadingSnapshot[] @relation("InvoiceSnapshotContext")
  flexibleServiceCharges               FlexibleServiceCharge[]
  invoiceMeterReadingSnapshotsAsSource InvoiceMeterReadingSnapshot[] @relation("InvoiceSnapshotSourceInvoice")

  @@unique([contractId, periodStart, periodEnd], map: "invoices_contract_id_period_start_period_end_key")
  @@unique([invoiceId, contractId, propertyId, ownerId], map: "invoices_invoice_id_contract_id_property_id_owner_id_key")
  @@index([ownerId, status, dueDate], map: "invoices_by_status_due")
  @@index([ownerId, periodStart(sort: Desc)], map: "invoices_by_period")
  @@map("invoices")
}

model PaymentTransaction {
  paymentTransactionId  BigInt    @id @default(autoincrement()) @map("payment_transaction_id")
  invoiceId             BigInt    @map("invoice_id")
  paymentSessionId      String    @map("payment_session_id") @db.Uuid
  provider              String    @db.VarChar(16)
  providerTransactionId String?   @map("provider_transaction_id") @db.VarChar(160)
  providerEventId       String?   @map("provider_event_id") @db.VarChar(160)
  providerReference     String?   @map("provider_reference") @db.VarChar(200)
  amount                BigInt
  currency              String    @default("VND") @db.Char(3)
  status                String    @default("pending") @db.VarChar(16)
  errorCode             String?   @map("error_code") @db.VarChar(100)
  errorMessage          String?   @map("error_message") @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt           DateTime? @map("processed_at") @db.Timestamptz(6)

  invoice Invoice @relation(fields: [invoiceId], references: [invoiceId], onDelete: Restrict)

  @@index([invoiceId, createdAt(sort: Desc)], map: "payment_by_invoice_created")
  @@index([paymentSessionId, createdAt], map: "payment_by_session")
  @@map("payment_transactions")
}

model InvoiceZaloOaSendLog {
  sendLogId           BigInt    @id @default(autoincrement()) @map("send_log_id")
  invoiceId           BigInt    @map("invoice_id")
  contractId          BigInt    @map("contract_id")
  propertyId          BigInt    @map("property_id")
  ownerId             BigInt    @map("owner_id")
  recipientResidentId BigInt    @map("recipient_resident_id")
  recipientPhone      String?   @map("recipient_phone") @db.VarChar(30)
  invoiceRevision     Int       @map("invoice_revision")
  status              String    @db.VarChar(16)
  providerMessageId   String?   @map("provider_message_id") @db.VarChar(160)
  providerResponse    Json?     @map("provider_response") @db.JsonB
  errorMessage        String?   @map("error_message") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt              DateTime? @map("sent_at") @db.Timestamptz(6)

  invoice   Invoice  @relation(fields: [invoiceId, contractId, propertyId, ownerId], references: [invoiceId, contractId, propertyId, ownerId], onDelete: Restrict)
  recipient Resident @relation(fields: [recipientResidentId, ownerId], references: [residentId, ownerId], onDelete: Restrict)

  @@index([invoiceId, createdAt(sort: Desc)], map: "invoice_zalo_logs_by_invoice")
  @@map("invoice_zalo_oa_send_logs")
}

model Amenity {
  amenityId        BigInt    @id @default(autoincrement()) @map("amenity_id")
  propertyId       BigInt    @map("property_id")
  ownerId          BigInt    @map("owner_id")
  amenityType      String    @map("amenity_type") @db.VarChar(16)
  name             String    @db.VarChar(150)
  description      String?   @db.Text
  location         String?   @db.VarChar(200)
  openingTime      DateTime? @map("opening_time") @db.Time(6)
  closingTime      DateTime? @map("closing_time") @db.Time(6)
  operatingInfo    String?   @map("operating_info") @db.Text
  rules            String?   @db.Text
  registrationType String    @default("information") @map("registration_type") @db.VarChar(20)
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  property           Property              @relation(fields: [propertyId, ownerId], references: [propertyId, ownerId], onDelete: Restrict)
  priceHistory       AmenityPriceHistory[]
  subscriptions      AmenitySubscription[]
  propertyFacilities PropertyFacility[]

  @@unique([propertyId, name], map: "amenities_property_id_name_key")
