{
  "name": "goctro",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "concurrently -k -n frontend,backend -c blue,green \"npm:dev --workspace=@goctro/frontend\" \"npm:dev --workspace=@goctro/backend\"",
    "dev:all": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/dev-all.ps1",
    "dev:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/dev-stop.ps1",
    "build": "npm run build --workspace=@goctro/frontend && npm run build --workspace=@goctro/backend",
    "db:up": "docker compose --env-file .env up -d --wait postgres18",
    "db:down": "docker compose --env-file .env stop postgres18",
    "db:bootstrap": "node scripts/database-v111.mjs bootstrap",
    "db:inspect": "node scripts/database-v111.mjs inspect",
    "db:state": "node scripts/database-v111.mjs state",
    "db:verify-artifacts": "node scripts/verify-baseline-integrity.mjs",
    "db:validate": "npm run db:validate --workspace=@goctro/backend",
    "test:db-setup": "node --test scripts/database-v18.test.mjs scripts/setup-cache.test.mjs",
    "test:db-setup:runtime": "node --test scripts/database-v18.integration.test.mjs",
    "db:generate": "npm run db:generate --workspace=@goctro/backend",
    "db:migrate": "node scripts/database-v111.mjs migrate-v110",
    "db:migrate:v19": "node scripts/database-v111.mjs migrate-v19",
    "db:migrate:v18": "node scripts/database-v19.mjs migrate-v18",
    "db:seed": "node scripts/database-v111.mjs seed"
  },
  "devDependencies": {
    "concurrently": "9.2.4"
  },
  "overrides": {
    "shell-quote": "1.11.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "prisma@6.12.0": true,
    "@prisma/client@6.12.0": true,
    "@prisma/engines@6.12.0": true
  }
}
